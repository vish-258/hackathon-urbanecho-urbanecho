# Keep scripts runnable after a checkout on another operating system.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.ino text eol=lf
*.h text eol=lf
Dockerfile text eol=lf
# Preserve the bundled upstream files exactly, including their line endings.
app/static/application/vendor/* -text -whitespace linguist-vendored
# These model metadata files are verified against pinned SHA-256 digests.
app/assets/yamnet/yamnet_class_map.csv -text -whitespace
app/assets/yamnet/category_mapping.v1.json -text
