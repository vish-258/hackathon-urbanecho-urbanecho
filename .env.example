# Copy to .env and supply unique random secrets, or run the setup script in README.
# Initialization creates these database roles once on an EMPTY database volume.
POSTGRES_DB=noise_monitor
POSTGRES_USER=noise_migrate
POSTGRES_PASSWORD=
APP_DB_USER=noise_app
APP_DB_PASSWORD=
ADMIN_TOKEN=

# API/worker reconnect settings and ingestion limits.
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY_SECONDS=1
MAX_UPLOAD_BYTES=20000000
MAX_DURATION_SECONDS=60
ALLOWED_SAMPLE_RATES=[16000,32000,44100,48000]
WORKER_POLL_SECONDS=1
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=2

# Daily reports: previous completed local day, queued after 00:05 in each timezone.
DAILY_SCHEDULE_ENABLED=true
DAILY_SCHEDULE_MINUTE=5
DAILY_SCHEDULE_POLL_SECONDS=60
DAILY_JOB_LEASE_SECONDS=600
DAILY_JOB_MAX_ATTEMPTS=5

# Live evaluation, data freshness and durable event replay.
LIVE_FRESHNESS_SECONDS=120
FUTURE_SKEW_SECONDS=5
DATA_STALE_SECONDS=30
RECOVERY_COUNT=3
EVENT_REPLAY_SECONDS=604800
SSE_POLL_SECONDS=0.25
SSE_HEARTBEAT_SECONDS=10
SSE_BATCH_SIZE=100

# Host-only development (Docker service settings are defined in compose.yaml):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# AUDIO_ROOT=./work/audio
# DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@localhost:5432/noise_monitor
# MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATOR:URL_ENCODED_PASSWORD@localhost:5432/noise_monitor
# DEV_DB_PORT=5432
# Apple Silicon optional default compose files:
# COMPOSE_FILE=compose.yaml:compose.amd64.yaml

# Local Compose API only: open /app automatically on this Mac.
# Keep the API bound to 127.0.0.1. Disable before any external hosting.
# LOCAL_BROWSER_ACCESS=true
