# Railway's single-volume service contains every runtime. The root Dockerfile
# keeps the local API/measurement image free of optional ML dependencies.
FROM python:3.12.14-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    LOCAL_BROWSER_ACCESS=false
WORKDIR /app

COPY requirements.txt requirements-classification.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements.txt \
    && pip install --no-cache-dir --require-hashes -r requirements-classification.txt \
    && groupadd --gid 10001 noise \
    && useradd --uid 10001 --gid 10001 --no-create-home noise \
    && mkdir -p /data/audio \
    && chown -R noise:noise /data/audio

COPY --chown=noise:noise app ./app
COPY --chown=noise:noise migrations ./migrations
COPY --chown=noise:noise scripts ./scripts
COPY --chown=noise:noise tests ./tests
COPY --chown=noise:noise alembic.ini pyproject.toml ./
RUN python -m scripts.fetch_yamnet --output /opt/urbanecho-models/yamnet.tflite

USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "scripts.serve_railway"]
